{
  "name": "tiled-platformer",
  "main": "src/main.ml",
  "window": {
    "title": "MiniPixels Tiled Platformer",
    "width": 320,
    "height": 180,
    "scale": 4
  },
  "levels": {
    "path": "assets/maps/demo.tmj"
  },
  "assets": [
    {"id": "background", "type": "image", "path": "assets/background.png"},
    {"id": "items", "type": "image", "path": "assets/items.png", "sheet": {"frameWidth": 32, "frameHeight": 32}},
    {
      "id": "tiles",
      "type": "image",
      "path": "assets/tiles.png",
      "sheet": {
        "frameWidth": 32,
        "frameHeight": 32,
        "spacing": 0,
        "margin": 0
      }
    },
    {
      "id": "player",
      "type": "image",
      "path": "assets/player.png"
    }
  ]
}
